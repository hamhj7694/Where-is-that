# 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키
# JavaScript 키: 인가 URL의 client_id. 서버가 프론트로 URL을 만들어 줄 때만 사용하고 브라우저 번들에는 넣지 않는다.
KAKAO_JAVASCRIPT_KEY=

# REST API 키: 인가 코드 -> 액세스 토큰 교환에 사용. 서버 전용.
KAKAO_REST_API_KEY=

# 클라이언트 시크릿은 서버 .env에만 둔다. 콘솔에서 시크릿을 끈 경우 비워 둔다.
KAKAO_CLIENT_SECRET=

# 카카오 콘솔에 등록한 Redirect URI. 프론트 라우트 /auth/kakao/callback과 정확히 일치해야 한다.
KAKAO_REDIRECT_URI=http://127.0.0.1:5173/auth/kakao/callback

# 개발 서버가 허용하는 프론트 출처(쉼표 구분). Origin 검사와 CORS에 사용한다.
# GEUGEO_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# 배포(HTTPS)에서는 쿠키에 Secure를 켠다. 개발에서는 기본값(false)으로 둔다.
# GEUGEO_COOKIE_SECURE=true

# DB 위치를 바꾸려면 지정한다. 기본값은 backend/data/app.db
# GEUGEO_DATA_DIR=C:\path\to\data

#---

# 경찰청 유실물 API (data.go.kr 활용신청 후 발급). 서버 전용, 브라우저에 노출하지 않는다.
# 일반 인증키를 '디코딩된' 상태로 넣는다. 인코딩된 키(%2B 등)를 넣으면 이중 인코딩되어 실패한다.
POLICE_SERVICE_KEY=

# 경찰청 API 호출 타임아웃(초), 검색/상세/지오코딩 캐시 유효시간(초)
# POLICE_API_TIMEOUT=8
# 직접 찾기 전체 스캔: 연결 재사용 + 동시 요청 수. 공개 API 부하를 고려해 기본 12/16을 유지한다.
# GEUGEO_POLICE_API_MAX_CONNECTIONS=16
# GEUGEO_BROWSE_MAX_WORKERS=12
# 전용 필터 API(분류·지역·색상·기간) 스캔 상한. 0이면 필터 결과의 마지막 페이지까지 읽는다.
# GEUGEO_LOSTFOUND_MAX_PAGES=200
# LOSTFOUND_SEARCH_TTL=300
# LOSTFOUND_DETAIL_TTL=86400
# GEO_CACHE_TTL=2592000

#---

# AI search (keys stay on the backend; restarting the server is required)
# One OpenAI key enables the default multimodal role.
OPENAI_API_KEY=

# 1) 멀티모달 역할: 자연어·이미지·자연어+이미지 joint 해석을 모두 담당한다.
# 기존 LLM/VLM/VISION 설정은 호환용 별칭이며, 아래 MULTIMODAL 설정이 우선한다.
GEUGEO_AI_MULTIMODAL_PROVIDER=openai-compatible
GEUGEO_AI_MULTIMODAL_MODEL=gpt-6-luna
# GEUGEO_AI_MULTIMODAL_BASE_URL=https://api.openai.com/v1
# GEUGEO_AI_MULTIMODAL_API_KEY=

# 2) 이미지 유사도 전용 비전: 사진 임베딩 코사인 유사도만 계산한다.
# 기본(local-clip)은 사전학습 가중치를 서버에서 직접 띄운다. YOLOE가 자연어 타깃만
# 크롭하고 CLIP이 벡터를 비교한다. 별도 학습/API 키/외부 서비스가 필요 없다.
# none: 전용 비전 없이 멀티모달 점수를 그대로 사용한다.
# openai-compatible: POST /embeddings (Voyage voyage-multimodal-3, Jina jina-clip-v2 등)
# clip-http: POST /embed {model,image:<base64>} -> {embedding:[...]}
GEUGEO_AI_SIMILARITY_PROVIDER=local-clip
# GEUGEO_LOCAL_VISION_ENABLED=true
# GEUGEO_LOCAL_CLIP_MODEL=ViT-B-32
# GEUGEO_LOCAL_CLIP_PRETRAINED=laion2b_s34b_b79k
# GEUGEO_LOCAL_CLIP_BATCH_SIZE=32
# GEUGEO_YOLOE_ENABLED=true
# GEUGEO_YOLOE_MODEL=data/models/yoloe-11s-seg.pt  # backend 디렉터리 기준
# GEUGEO_YOLOE_CONFIDENCE=0.12
# GEUGEO_YOLOE_MAX_DETECTIONS=10
# 크롭 게이팅: 객체가 2개 이상이거나 종류가 2가지 이상일 때만 자른다(단일 객체는 원본 유지).
# GEUGEO_CROP_MIN_OBJECTS=2
# GEUGEO_CROP_MIN_OBJECT_TYPES=2
# VLM이 사진별 객체 종류 수를 한 번의 배치 호출로 판정해 위 조건에 OR로 더한다.
# 실패하거나 끄면 YOLOE census만 사용한다.
# GEUGEO_VLM_CROP_CENSUS=true
# GEUGEO_CROP_CENSUS_CONFIDENCE=0.25
# GEUGEO_CROP_MAX_BOX_RATIO=0.60
# 텍스트 전용 CLIP 점수가 평평하면 멀티모달 폴백을 호출한다(참고 사진이 있으면 로컬 유지).
# GEUGEO_TEXT_FALLBACK_MAX_SCORE=70
# GEUGEO_TEXT_FALLBACK_MIN_GAP=5
# 검색 카테고리 키워드가 있는 후보만 CLIP 비교(최대 8건). 나머지는 텍스트 점수만 붙인다.
# GEUGEO_VISUAL_MATCH_MAX_COMPARE=8
GEUGEO_AI_SIMILARITY_MODEL=
GEUGEO_AI_SIMILARITY_INPUT_STYLE=image_url
# GEUGEO_AI_SIMILARITY_BASE_URL=https://api.openai.com/v1
# GEUGEO_AI_SIMILARITY_API_KEY=
# GEUGEO_AI_SIMILARITY_TIMEOUT=20

# 이전 역할 설정(호환용). 새 설정을 쓰면 비워도 된다.
GEUGEO_AI_LLM_PROVIDER=openai-compatible
GEUGEO_AI_LLM_MODEL=gpt-6-luna
GEUGEO_AI_VLM_PROVIDER=openai-compatible
GEUGEO_AI_VLM_MODEL=gpt-6-luna
GEUGEO_AI_VISION_PROVIDER=openai-compatible
GEUGEO_AI_VISION_MODEL=gpt-6-luna
# GEUGEO_AI_TIMEOUT=45